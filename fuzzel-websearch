#!/bin/bash


engine=$(printf "Google\nProtonDB" | fuzzel --dmenu --prompt="Search engine: ")
[ -z "$engine" ] && exit

query=$(echo "" | fuzzel --dmenu --prompt="Search: ")
[ -z "$query" ] && exit

encoded=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$query")

case "$engine" in
    Google)   xdg-open "https://google.com/search?q=$encoded" ;;
    ProtonDB) xdg-open "https://www.protondb.com/search?q=$encoded" ;;
esac
